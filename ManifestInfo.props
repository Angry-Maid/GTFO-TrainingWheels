<Project>
    <PropertyGroup>
        <TSName>TrainingWheels</TSName>
        <TSAuthor>Angry-Maid</TSAuthor>
        <TSVersion>0.0.3</TSVersion> <!-- TSVersion empty = GitInfo used instead (if available; check nuget) -->
        <TSWebsite>https://github.com/Angry-Maid/GTFO-TrainingWheels</TSWebsite>
        <TSDescription>A silly mod to put on some training wheels on prisoners.</TSDescription>
    </PropertyGroup>
    <ItemGroup>
        <!-- Add the Dependency strings here, one for each dependency -->
        <TSDependencyStrings Include="BepInEx-BepInExPack_GTFO-3.2.1" InProject="false" />
        <!-- <TSDependencyStrings Include="Some-Other-Dependency-1.2.3" InProject="false" /> -->
    </ItemGroup>
</Project>
